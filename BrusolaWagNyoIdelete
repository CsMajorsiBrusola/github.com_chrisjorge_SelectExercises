drop table grade

select vFirstName, vLastname, vSubject, ((iPrelim * 0.2 ) + (iMidterm * 0.2) + (iPrefinal * 0.2) + (iFinal * 0.4)) as SemGrade,
Case 
	when ((iPrelim * 0.2 ) + (iMidterm * 0.2) + (iPrefinal * 0.2) + (iFinal * 0.4)) < 60.00
	then 'Failed' 
	else 'Passed'
End as Remarks
from grade
order by vSubject
